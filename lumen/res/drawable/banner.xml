<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF0B0B12" android:endColor="#FF1E2140" />
        </shape>
    </item>
    <item android:width="56dp" android:height="56dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="28dp"
                android:startColor="#FFFFFFFF" android:centerColor="#FFB8C6FF" android:endColor="#00B8C6FF" />
        </shape>
    </item>
</layer-list>
